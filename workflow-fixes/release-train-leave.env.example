# Configuration template for Release Train – Leave (.github/workflows/release-train-leave.yml)

# ==========================================
# GitHub Repository Variables (Optional)
# Settings -> Secrets and variables -> Actions -> Variables
# ==========================================

# Runner image/label override (Defaults to ubuntu-latest if not specified)
UBUNTU_MEDIUM=ubuntu-latest

# ==========================================
# GitHub Repository Secrets (Optional)
# Settings -> Secrets and variables -> Actions -> Secrets
# ==========================================

# Personal Access Token or App Installation Token with 'actions:write' scope on the external release train orchestrator repo.
# If omitted or running in standalone mode, workflow de-registers locally and records all details to Job Summary.
RELEASE_TRAIN_PARTICIPANT_GITHUB_TOKEN=

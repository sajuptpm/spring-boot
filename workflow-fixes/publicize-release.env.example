# ==============================================================================
# Environment Configuration Template for: publicize-release.yml
# Copy this file to 'publicize-release.env' and populate with your own values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPTIONAL SECRETS (GitHub Actions Secrets)
# In this fork, GITHUB_TOKEN is used by default with 'contents: write' and 'issues: write'.
# No secrets are mandatory unless you enable external publishing services.
# ------------------------------------------------------------------------------

# GitHub Personal Access Token (PAT) with 'repo' scope.
# Only needed if you want release creation events to trigger downstream actions.
GH_ACTIONS_REPO_TOKEN=

# Gradle Plugin Portal publishing credentials.
# Only needed if ENABLE_PUBLISH_GRADLE_PLUGIN is set to 'true'.
GRADLE_PLUGIN_PUBLISH_KEY=
GRADLE_PLUGIN_PUBLISH_SECRET=

# JFrog Artifactory Spring access token.
# Only needed if ENABLE_PUBLISH_GRADLE_PLUGIN is set to 'true'.
JF_ARTIFACTORY_SPRING=

# SDKMAN! Vendor API credentials for candidates.
# Only needed if ENABLE_SDKMAN_PUBLISH is set to 'true'.
SDKMAN_CONSUMER_KEY=
SDKMAN_CONSUMER_TOKEN=

# ------------------------------------------------------------------------------
# 2. REPOSITORY VARIABLES (GitHub Actions Variables)
# Configure these in: Settings > Secrets and variables > Actions > Variables
# ------------------------------------------------------------------------------

# Set to 'true' to attempt publishing the Gradle plugin to Gradle Plugin Portal
ENABLE_PUBLISH_GRADLE_PLUGIN=false

# Set to 'true' to publish candidate release to SDKMAN!
ENABLE_SDKMAN_PUBLISH=false

# Set to 'true' to update your Homebrew tap
ENABLE_HOMEBREW_TAP=false

# Set to 'true' to trigger docs build workflow on the docs-build branch
TRIGGER_DOCS_BUILD=false

# Set to 'true' to generate commercial release notes instead of OSS
COMMERCIAL=false

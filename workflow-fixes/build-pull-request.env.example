# ==============================================================================
# Configuration & Credentials for build-pull-request.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle Develocity / Build Scans (Optional)
# ------------------------------------------------------------------------------
# [SECRET] Access key for Gradle Develocity (ge.spring.io or custom instance)
# If provided, builds will publish a Develocity build scan link.
DEVELOCITY_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 2. Runner & Workflow Options (Optional)
# ------------------------------------------------------------------------------
# Custom runner label for pull request builds (default: ubuntu-latest)
UBUNTU_MEDIUM="ubuntu-latest"

# Optional fallback flag to enable PR builds if repository name is modified
ENABLE_PR_BUILD="false"

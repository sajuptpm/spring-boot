# ==============================================================================
# Environment Configuration Template for verify.yml
# ==============================================================================
# Copy this file to verify.env and configure variables for local or CI runs.

# ------------------------------------------------------------------------------
# Workflow Dispatch Inputs
# ------------------------------------------------------------------------------
# Target Spring Boot version to verify
VERIFY_VERSION=4.2.0-SNAPSHOT

# Whether the release artifacts are in the staging repository (true / false)
VERIFY_STAGING=false

# Verification Mode:
#   auto     - Auto-detects access to spring-projects/spring-boot-release-verification.
#              Uses original mode if accessible; falls back to native mode otherwise.
#   native   - Runs built-in Spring Boot smoke tests (:smoke-test:spring-boot-smoke-test-simple:test)
#              and project version integrity validation (100% free, zero external credentials).
#   original - Clones external RVT repository (spring-projects/spring-boot-release-verification)
#              and runs external verification tests. Requires Broadcom private repo PAT.
VERIFY_MODE=auto

# ------------------------------------------------------------------------------
# Repository Variables (GitHub Settings -> Secrets and variables -> Actions -> Variables)
# ------------------------------------------------------------------------------
# Custom runner label (defaults to ubuntu-latest if not specified)
# UBUNTU_SMALL=ubuntu-latest

# Commercial release toggle (set to true for commercial VMware/Broadcom releases)
# COMMERCIAL=false

# ------------------------------------------------------------------------------
# Repository Secrets (GitHub Settings -> Secrets and variables -> Actions -> Secrets)
# ------------------------------------------------------------------------------
# Personal Access Token with access to private spring-projects/spring-boot-release-verification
# (Only required if running in 'original' mode)
# GH_ACTIONS_REPO_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Repository credentials for external RVT verification
# COMMERCIAL_REPOSITORY_USERNAME=
# COMMERCIAL_REPOSITORY_PASSWORD=
# OPENSOURCE_REPOSITORY_USERNAME=
# OPENSOURCE_REPOSITORY_PASSWORD=

# Optional Google Chat Webhook URL for build notifications
# GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/.../messages?key=...

# Optional Gradle Develocity access key for build scans
# DEVELOCITY_ACCESS_KEY=

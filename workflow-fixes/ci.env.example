# ==============================================================================
# Configuration & Credentials for ci.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle Develocity / Build Scans (Optional)
# ------------------------------------------------------------------------------
# [SECRET] Access key for Gradle Develocity (ge.spring.io or custom instance)
# If provided, builds will publish a Develocity build scan link.
DEVELOCITY_ACCESS_KEY=""

# ------------------------------------------------------------------------------
# 2. Google Chat Notifications (Optional)
# ------------------------------------------------------------------------------
# [SECRET] Webhook URL for Google Chat space to receive matrix build status alerts
GOOGLE_CHAT_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 3. Runner & Workflow Options (Optional)
# ------------------------------------------------------------------------------
# Custom runner label for Linux matrix jobs (default: ubuntu-latest)
UBUNTU_MEDIUM="ubuntu-latest"

# Optional fallback flag to enable CI builds if repository name is modified
ENABLE_CI="false"

# ------------------------------------------------------------------------------
# 4. Commercial Distribution Mode (Optional - default is false / open-source)
# ------------------------------------------------------------------------------
COMMERCIAL="false"
COMMERCIAL_RELEASE_REPO_URL=""
COMMERCIAL_SNAPSHOT_REPO_URL=""
COMMERCIAL_ARTIFACTORY_USERNAME=""
COMMERCIAL_ARTIFACTORY_PASSWORD=""

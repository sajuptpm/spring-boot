# ==============================================================================
# Configuration & Credentials for publicize-milestone.yml
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle Plugin Portal Publishing (Optional)
# ------------------------------------------------------------------------------
# Set to "true" only if you own the plugin ID on plugins.gradle.org and want to publish
ENABLE_PUBLISH_GRADLE_PLUGIN="false"

# [SECRET] Gradle Plugin Portal API publishing key
GRADLE_PLUGIN_PUBLISH_KEY=""

# [SECRET] Gradle Plugin Portal API publishing secret
GRADLE_PLUGIN_PUBLISH_SECRET=""

# [SECRET] JFrog CLI token for downloading plugin artifacts from Artifactory
JF_ARTIFACTORY_SPRING=""


# ------------------------------------------------------------------------------
# 2. GitHub Release Token (Optional)
# ------------------------------------------------------------------------------
# [SECRET] GitHub Personal Access Token (PAT) with repo and write permissions.
# If omitted, the workflow automatically falls back to built-in GITHUB_TOKEN!
GH_ACTIONS_REPO_TOKEN=""


# ------------------------------------------------------------------------------
# 3. Documentation Build Trigger (Optional)
# ------------------------------------------------------------------------------
# Set to "true" to trigger docs build on docs-build branch
TRIGGER_DOCS_BUILD="false"


# ------------------------------------------------------------------------------
# 4. Commercial Distribution Mode (Optional)
# ------------------------------------------------------------------------------
COMMERCIAL="false"

# Configuration template for Release Train – Build (.github/workflows/release-train-build.yml)

# ==========================================
# GitHub Repository Variables (Optional)
# Settings -> Secrets and variables -> Actions -> Variables
# ==========================================

# Runner image/label override (Defaults to ubuntu-latest if not specified)
# Upstream uses Broadcom internal label 'ubuntu22-2-8'
UBUNTU_MEDIUM=ubuntu-latest

# Allow workflow re-runs (default 'false' preserves release train immutability)
RELEASE_TRAIN_ALLOW_RERUNS=false

# Perform repeated build for byte-for-byte reproducibility verification (default 'false' for fast execution)
RELEASE_TRAIN_REPEAT_BUILD=false

# Commercial Artifactory repository URL (Enterprise Spring only)
COMMERCIAL_RELEASE_REPO_URL=

# ==========================================
# GitHub Repository Secrets (Optional)
# Settings -> Secrets and variables -> Actions -> Secrets
# ==========================================

# Personal Access Token or App Installation Token with 'actions:write' scope on the callback repository.
# If omitted or running in standalone mode, workflow records all artifact details to Job Summary.
RELEASE_TRAIN_PARTICIPANT_GITHUB_TOKEN=

# Gradle Develocity Access Key (for build cache and ge.spring.io build scans)
DEVELOCITY_ACCESS_KEY=

# Release train participant upstream maven repository credentials (if chained in train)
RELEASE_TRAIN_PARTICIPANT_MAVEN_REPOSITORY_USERNAME=
RELEASE_TRAIN_PARTICIPANT_MAVEN_REPOSITORY_PASSWORD=

# Commercial Artifactory credentials (Enterprise Spring only)
COMMERCIAL_ARTIFACTORY_USERNAME=
COMMERCIAL_ARTIFACTORY_PASSWORD=

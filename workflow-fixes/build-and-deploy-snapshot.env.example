# ==============================================================================
# Configuration & Credentials for build-and-deploy-snapshot.yml
# Copy this file to build-and-deploy-snapshot.env to add your real values locally.
# (build-and-deploy-snapshot.env is git-ignored to prevent accidental commits).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Artifactory / Maven Repository Deployment
# ------------------------------------------------------------------------------
# Target Artifactory or Maven repository base URL.
# Upstream default: https://repo.spring.io
# If deploying to your own JFrog Artifactory or repository, set your URL here:
ARTIFACTORY_DEPLOY_REPO_URL="https://repo.spring.io"

# Target repository name in Artifactory (upstream default: libs-snapshot-local)
ARTIFACTORY_REPOSITORY="libs-snapshot-local"

# Optional project key in Artifactory
ARTIFACTORY_PROJECT=""

# [SECRET] Username with write/deploy permissions to your repository
ARTIFACTORY_USERNAME=""

# [SECRET] Password or API token for repository authentication
ARTIFACTORY_PASSWORD=""


# ------------------------------------------------------------------------------
# 2. PGP / GPG Artifact Signing (Optional)
# ------------------------------------------------------------------------------
# [SECRET] ASCII-armored PGP/GPG private key block (starts with -----BEGIN PGP PRIVATE KEY BLOCK-----)
GPG_PRIVATE_KEY=""

# [SECRET] Passphrase for GPG_PRIVATE_KEY (leave empty if not password protected)
GPG_PASSPHRASE=""


# ------------------------------------------------------------------------------
# 3. Notification Webhooks (Optional)
# ------------------------------------------------------------------------------
# [SECRET] Google Chat webhook URL for receiving build failure/success alerts
GOOGLE_CHAT_WEBHOOK_URL=""


# ------------------------------------------------------------------------------
# 4. Gradle Develocity / Build Scans (Optional)
# ------------------------------------------------------------------------------
# [SECRET] Access key for Gradle Develocity (ge.spring.io or custom instance)
DEVELOCITY_ACCESS_KEY=""


# ------------------------------------------------------------------------------
# 5. Documentation & Verification Options (Optional)
# ------------------------------------------------------------------------------
# Set to "true" to trigger Antora docs build workflow on docs-build branch
TRIGGER_DOCS_BUILD="false"

# Set to "true" to run release verification tests
ENABLE_VERIFY="false"

# [SECRET] GitHub PAT for checking out the verification repository if ENABLE_VERIFY="true"
GH_ACTIONS_REPO_TOKEN=""


# ------------------------------------------------------------------------------
# 6. Commercial Distribution Mode (Optional - default is false / open-source)
# ------------------------------------------------------------------------------
COMMERCIAL="false"
COMMERCIAL_RELEASE_REPO_URL=""
COMMERCIAL_SNAPSHOT_REPO_URL=""
COMMERCIAL_DEPLOY_REPO_URL=""
COMMERCIAL_ARTIFACTORY_USERNAME=""
COMMERCIAL_ARTIFACTORY_PASSWORD=""
